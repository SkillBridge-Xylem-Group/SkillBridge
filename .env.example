NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for notifications, XP/trust updates, shared rate limits.
# Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public site origin used for auth email links (prevents Host header attacks).
NEXT_PUBLIC_SITE_URL=https://sandbox.skillbridge-tech.my.id

# Optional comma-separated extra origins allowed as getRequestOrigin fallbacks.
# ALLOWED_ORIGINS=https://skillbridge-tech.my.id

# Optional dedicated secret for swap-session Realtime channel tokens.
# SWAP_CHANNEL_SECRET=

# Optional Giphy proxy (server-side only).
# GIPHY_API_KEY=
